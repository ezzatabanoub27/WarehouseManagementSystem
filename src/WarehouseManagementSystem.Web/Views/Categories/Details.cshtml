@model WarehouseManagementSystem.Application.DTOs.Categories.CategoryDto

@{
    ViewData["Title"] = "Category Details";
}

<div class="mx-auto max-w-7xl space-y-10">

    <!-- Header -->
    <div class="flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">

        <div>
            <a asp-action="Index"
               class="text-xs font-medium text-slate-400 transition hover:text-slate-700 dark:hover:text-slate-200">
                Categories
            </a>

            <div class="mt-3">
                <h1 class="text-2xl font-semibold tracking-tight text-slate-900 dark:text-white">
                    @Model.Name
                </h1>

                <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">
                    Category details and information.
                </p>
            </div>
        </div>

        <a asp-action="Edit"
           asp-route-id="@Model.Id"
           class="dashboard-button-primary inline-flex items-center justify-center gap-2 !px-4 !py-2.5 !text-sm">
            Edit Category
        </a>
    </div>

    <!-- Details -->
    <div class="max-w-4xl divide-y divide-slate-200 border-y border-slate-200 dark:divide-slate-800 dark:border-slate-800">

        <!-- General Information -->
        <div class="grid gap-3 py-6 sm:grid-cols-3">
            <div class="text-sm font-medium text-slate-500 dark:text-slate-400">
                Category Name
            </div>

            <div class="text-sm text-slate-900 dark:text-white sm:col-span-2">
                @Model.Name
            </div>
        </div>

        <!-- Parent -->
        <div class="grid gap-3 py-6 sm:grid-cols-3">
            <div class="text-sm font-medium text-slate-500 dark:text-slate-400">
                Parent Category
            </div>

            <div class="text-sm text-slate-900 dark:text-white sm:col-span-2">
                @(Model.ParentCategoryName ?? "Root Category")
            </div>
        </div>

        <!-- Status -->
        <div class="grid gap-3 py-6 sm:grid-cols-3">
            <div class="text-sm font-medium text-slate-500 dark:text-slate-400">
                Status
            </div>

            <div class="sm:col-span-2">
                @if (Model.IsActive)
                {
                    <span class="inline-flex items-center gap-1.5 text-sm font-medium text-emerald-600 dark:text-emerald-400">
                        <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
                        Active
                    </span>
                }
                else
                {
                    <span class="inline-flex items-center gap-1.5 text-sm font-medium text-slate-500 dark:text-slate-400">
                        <span class="h-2 w-2 rounded-full bg-slate-400"></span>
                        Inactive
                    </span>
                }
            </div>
        </div>

        <!-- Products -->
        <div class="grid gap-3 py-6 sm:grid-cols-3">
            <div class="text-sm font-medium text-slate-500 dark:text-slate-400">
                Products
            </div>

            <div class="text-sm text-slate-900 dark:text-white sm:col-span-2">
                @Model.ProductsCount
            </div>
        </div>

        <!-- Subcategories -->
        <div class="grid gap-3 py-6 sm:grid-cols-3">
            <div class="text-sm font-medium text-slate-500 dark:text-slate-400">
                Subcategories
            </div>

            <div class="text-sm text-slate-900 dark:text-white sm:col-span-2">
                @Model.SubCategoriesCount
            </div>
        </div>

        <!-- Description -->
        <div class="grid gap-3 py-6 sm:grid-cols-3">
            <div class="text-sm font-medium text-slate-500 dark:text-slate-400">
                Description
            </div>

            <div class="whitespace-pre-line text-sm leading-7 text-slate-700 dark:text-slate-300 sm:col-span-2">
                @(string.IsNullOrWhiteSpace(Model.Description) ? "No description provided." : Model.Description)
            </div>
        </div>

        <!-- Created -->
        <div class="grid gap-3 py-6 sm:grid-cols-3">
            <div class="text-sm font-medium text-slate-500 dark:text-slate-400">
                Created At
            </div>

            <div class="text-sm text-slate-700 dark:text-slate-300 sm:col-span-2">
                @Model.CreatedAtUtc.ToString("dd MMM yyyy")
            </div>
        </div>

    </div>

    <!-- Footer -->
    <div class="flex items-center gap-3">
        <a asp-action="Index"
           class="inline-flex items-center justify-center rounded-lg px-4 py-2.5 text-sm font-medium text-slate-500 transition hover:bg-slate-100 hover:text-slate-800 dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-white">
            Back to Categories
        </a>
    </div>

</div>
