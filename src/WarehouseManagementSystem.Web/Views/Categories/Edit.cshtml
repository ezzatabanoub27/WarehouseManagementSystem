@model WarehouseManagementSystem.Application.DTOs.Categories.UpdateCategoryDto
@using WarehouseManagementSystem.Application.DTOs.Categories

@{
    ViewData["Title"] = "Edit Category";

    var parentCategories = ViewBag.ParentCategories as IEnumerable<CategoryDto>
                           ?? Enumerable.Empty<CategoryDto>();
}

<div class="mx-auto max-w-7xl space-y-10">

    <!-- Header -->
    <div>
        <a asp-action="Index"
           class="text-xs font-medium text-slate-400 transition hover:text-slate-700 dark:hover:text-slate-200">
            Categories
        </a>

        <div class="mt-3">
            <h1 class="text-2xl font-semibold tracking-tight text-slate-900 dark:text-white">
                Edit Category
            </h1>
            <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">
                Update category information and settings.
            </p>
        </div>
    </div>

    <!-- Form -->
    <div class="max-w-3xl">

        <form asp-action="Edit"
              method="post"
              class="space-y-8">

            @Html.AntiForgeryToken()

            <input asp-for="Id" type="hidden" />

            <div asp-validation-summary="ModelOnly"
                 class="text-sm text-red-600 dark:text-red-400">
            </div>

            <div class="space-y-7">

                <!-- Name -->
                <div>
                    <label asp-for="Name"
                           class="mb-2 block text-sm font-medium text-slate-700 dark:text-slate-200">
                        Category Name <span class="text-red-500">*</span>
                    </label>

                    <input asp-for="Name"
                           class="dashboard-input w-full"
                           placeholder="Category name" />

                    <span asp-validation-for="Name"
                          class="mt-1 block text-xs text-red-500"></span>
                </div>

                <!-- Parent -->
                <div>
                    <label asp-for="ParentCategoryId"
                           class="mb-2 block text-sm font-medium text-slate-700 dark:text-slate-200">
                        Parent Category
                    </label>

                    <select asp-for="ParentCategoryId"
                            class="dashboard-input w-full">
                        <option value="">None (Root Category)</option>

                        @foreach (var category in parentCategories)
                        {
                            <option value="@category.Id">
                                @category.Name
                            </option>
                        }
                    </select>

                    <span asp-validation-for="ParentCategoryId"
                          class="mt-1 block text-xs text-red-500"></span>
                </div>

                <!-- Description -->
                <div>
                    <label asp-for="Description"
                           class="mb-2 block text-sm font-medium text-slate-700 dark:text-slate-200">
                        Description
                    </label>

                    <textarea asp-for="Description"
                              rows="4"
                              placeholder="Add a short description (optional)"
                              class="dashboard-input w-full resize-y"></textarea>

                    <span asp-validation-for="Description"
                          class="mt-1 block text-xs text-red-500"></span>
                </div>

                <!-- Status -->
                <div class="flex items-center justify-between border-t border-slate-200 pt-6 dark:border-slate-800">
                    <div>
                        <p class="text-sm font-medium text-slate-700 dark:text-slate-200">
                            Category Status
                        </p>
                        <p class="mt-1 text-xs text-slate-400">
                            Inactive categories cannot be used as parent categories.
                        </p>
                    </div>

                    <label class="relative inline-flex cursor-pointer items-center">
                        <input asp-for="IsActive"
                               type="checkbox"
                               class="peer sr-only" />

                        <div class="h-6 w-11 rounded-full bg-slate-200 transition peer-checked:bg-blue-600 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-blue-100 dark:bg-slate-700 dark:peer-focus:ring-blue-900/30
                                    after:absolute after:left-[3px] after:top-[3px] after:h-[18px] after:w-[18px] after:rounded-full after:bg-white after:transition-all peer-checked:after:translate-x-5">
                        </div>
                    </label>
                </div>

            </div>

            <!-- Actions -->
            <div class="flex items-center gap-3 border-t border-slate-200 pt-6 dark:border-slate-800">

                <button type="submit"
                        class="dashboard-button-primary !px-4 !py-2.5 !text-sm">
                    Save Changes
                </button>

                <a asp-action="Index"
                   class="inline-flex items-center justify-center rounded-lg px-4 py-2.5 text-sm font-medium text-slate-500 transition hover:bg-slate-100 hover:text-slate-800 dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-white">
                    Cancel
                </a>

            </div>

        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
