@model IEnumerable<WarehouseManagementSystem.Application.DTOs.Products.ProductDto>

@{
    ViewData["Title"] = "Products";
}

<div class="space-y-6">

    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <h1 class="text-2xl font-semibold text-gray-900 dark:text-white">
                Products
            </h1>
            <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
                Manage your product catalog.
            </p>
        </div>

        <a asp-action="Create" class="dashboard-button-primary">
            + Add Product
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="p-3 rounded-lg bg-green-50 text-green-700 dark:bg-green-900/20 dark:text-green-400 text-sm">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="p-3 rounded-lg bg-red-50 text-red-700 dark:bg-red-900/20 dark:text-red-400 text-sm">
            @TempData["Error"]
        </div>
    }

    <div class="dashboard-card overflow-hidden">

        @if (Model.Any())
        {
            <div class="overflow-x-auto">
                <table class="w-full text-sm text-left">
                    <thead class="text-xs uppercase text-gray-500 dark:text-gray-400 border-b border-gray-200 dark:border-gray-700">
                        <tr>
                            <th class="px-5 py-4">Product</th>
                            <th class="px-5 py-4">SKU</th>
                            <th class="px-5 py-4">Category</th>
                            <th class="px-5 py-4">Unit</th>
                            <th class="px-5 py-4">Selling Price</th>
                            <th class="px-5 py-4">Status</th>
                            <th class="px-5 py-4 text-right">Actions</th>
                        </tr>
                    </thead>

                    <tbody class="divide-y divide-gray-100 dark:divide-gray-700">
                        @foreach (var product in Model)
                        {
                            <tr class="hover:bg-gray-50 dark:hover:bg-gray-800/50">

                                <td class="px-5 py-4">
                                    <div class="flex items-center gap-3 min-w-48">

                                        <div class="w-11 h-11 rounded-lg overflow-hidden bg-gray-100 dark:bg-gray-700 flex-shrink-0 flex items-center justify-center">
                                            @if (!string.IsNullOrWhiteSpace(product.ImagePath))
                                            {
                                                <img src="@product.ImagePath"
                                                     alt="@product.Name"
                                                     class="w-full h-full object-cover" />
                                            }
                                            else
                                            {
                                                <span class="text-gray-400 text-xs">N/A</span>
                                            }
                                        </div>

                                        <div>
                                            <p class="font-medium text-gray-900 dark:text-white">
                                                @product.Name
                                            </p>
                                            @if (!string.IsNullOrWhiteSpace(product.Barcode))
                                            {
                                                <p class="text-xs text-gray-500 mt-1">
                                                    @product.Barcode
                                                </p>
                                            }
                                        </div>
                                    </div>
                                </td>

                                <td class="px-5 py-4 text-gray-600 dark:text-gray-300">
                                    @product.SKU
                                </td>

                                <td class="px-5 py-4 text-gray-600 dark:text-gray-300">
                                    @product.CategoryName
                                </td>

                                <td class="px-5 py-4 text-gray-600 dark:text-gray-300">
                                    @(string.IsNullOrWhiteSpace(product.UnitSymbol) ? "—" : product.UnitSymbol)
                                </td>

                                <td class="px-5 py-4 font-medium text-gray-900 dark:text-white">
                                    @product.SellingPrice.ToString("N2")
                                </td>

                                <td class="px-5 py-4">
                                    @if (product.IsActive)
                                    {
                                        <span class="px-2.5 py-1 rounded-full text-xs bg-green-50 text-green-700 dark:bg-green-900/20 dark:text-green-400">
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="px-2.5 py-1 rounded-full text-xs bg-gray-100 text-gray-600 dark:bg-gray-700 dark:text-gray-300">
                                            Inactive
                                        </span>
                                    }
                                </td>

                                <td class="px-5 py-4">
                                    <div class="flex items-center justify-end gap-3">
                                        <a asp-action="Details"
                                           asp-route-id="@product.Id"
                                           class="text-gray-500 hover:text-indigo-600 dark:hover:text-indigo-400">
                                            Details
                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@product.Id"
                                           class="text-indigo-600 hover:text-indigo-800 dark:text-indigo-400">
                                            Edit
                                        </a>

                                        <form asp-action="Delete"
                                              asp-route-id="@product.Id"
                                              method="post"
                                              onsubmit="return confirm('Are you sure you want to delete this product?');">
                                            <button type="submit"
                                                    class="text-red-500 hover:text-red-700">
                                                Delete
                                            </button>
                                        </form>
                                    </div>
                                </td>

                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="py-16 text-center">
                <h3 class="text-base font-medium text-gray-900 dark:text-white">
                    No products found
                </h3>
                <p class="mt-2 text-sm text-gray-500">
                    Start by adding your first product.
                </p>
                <a asp-action="Create"
                   class="inline-block mt-4 dashboard-button-primary">
                    Add Product
                </a>
            </div>
        }

    </div>
</div>
