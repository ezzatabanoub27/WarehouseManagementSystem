@model WarehouseManagementSystem.Application.DTOs.Warehouses.WarehouseDto

@{
    ViewData["Title"] = "Warehouse Details";
}

<div class="mx-auto max-w-6xl space-y-6">

    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-sm text-slate-500 dark:text-slate-400">
        <a asp-action="Index" class="transition hover:text-blue-600">Warehouses</a>
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m9 18 6-6-6-6" />
        </svg>
        <span class="font-medium text-slate-800 dark:text-slate-200">Details</span>
    </nav>

    <!-- Hero Header -->
    <div class="dashboard-card overflow-hidden">
        <div class="h-20 bg-gradient-to-r from-blue-600 via-blue-500 to-indigo-500"></div>

        <div class="flex flex-col gap-5 px-6 pb-6 sm:flex-row sm:items-end sm:justify-between">

            <div class="-mt-10 flex flex-col gap-4 sm:flex-row sm:items-end">
                <div class="flex h-20 w-20 shrink-0 items-center justify-center rounded-2xl border-4 border-white
                            bg-blue-50 text-blue-600 shadow-lg dark:border-slate-900 dark:bg-slate-800 dark:text-blue-400">
                    <svg class="h-9 w-9" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"
                              d="M3 21V7l9-4 9 4v14M3 21h18M9 21v-6h6v6M7 10h.01M12 10h.01M17 10h.01" />
                    </svg>
                </div>

                <div class="pb-1">
                    <div class="flex flex-wrap items-center gap-3">
                        <h1 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white">
                            @Model.Name
                        </h1>

                        @if (Model.IsActive)
                        {
                            <span class="inline-flex items-center gap-2 rounded-full bg-emerald-50 px-3 py-1 text-xs
                                         font-semibold text-emerald-700 dark:bg-emerald-500/10 dark:text-emerald-400">
                                <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
                                Active
                            </span>
                        }
                        else
                        {
                            <span class="inline-flex items-center gap-2 rounded-full bg-red-50 px-3 py-1 text-xs
                                         font-semibold text-red-700 dark:bg-red-500/10 dark:text-red-400">
                                <span class="h-2 w-2 rounded-full bg-red-500"></span>
                                Inactive
                            </span>
                        }
                    </div>

                    <p class="mt-1 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-slate-500 dark:text-slate-400">
                        <span class="rounded-md bg-slate-100 px-2 py-0.5 font-mono text-xs font-medium
                                     text-slate-600 dark:bg-slate-800 dark:text-slate-300">@Model.Code</span>
                        <span>@Model.BranchName</span>
                    </p>
                </div>
            </div>

            <div class="flex flex-wrap items-center gap-3">
                <a asp-action="Index"
                   class="inline-flex items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white
                          px-4 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-50
                          dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800">
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                    </svg>
                    Back
                </a>

                <a asp-action="Edit" asp-route-id="@Model.Id" class="dashboard-button-primary">
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                    </svg>
                    Edit Warehouse
                </a>
            </div>
        </div>
    </div>

    <!-- Overview Cards -->
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">

        <div class="dashboard-card p-5">
            <div class="flex items-center justify-between">
                <p class="text-sm font-medium text-slate-500 dark:text-slate-400">Warehouse Code</p>
                <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-blue-50 text-blue-600
                            dark:bg-blue-500/10 dark:text-blue-400">
                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"
                              d="M7 7h.01M7 3h5l9 9-9 9-9-9V7a4 4 0 014-4z" />
                    </svg>
                </div>
            </div>
            <p class="mt-3 font-mono text-xl font-bold text-slate-900 dark:text-white">@Model.Code</p>
        </div>

        <div class="dashboard-card p-5">
            <div class="flex items-center justify-between">
                <p class="text-sm font-medium text-slate-500 dark:text-slate-400">Assigned Branch</p>
                <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-violet-50 text-violet-600
                            dark:bg-violet-500/10 dark:text-violet-400">
                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"
                              d="M3 21h18M5 21V7l8-4v18M19 21V11l-6-4M9 9v.01M9 12v.01M9 15v.01M9 18v.01" />
                    </svg>
                </div>
            </div>
            <p class="mt-3 text-xl font-bold text-slate-900 dark:text-white">@Model.BranchName</p>
        </div>

        <div class="dashboard-card p-5">
            <div class="flex items-center justify-between">
                <p class="text-sm font-medium text-slate-500 dark:text-slate-400">Current Status</p>
                <div class="flex h-9 w-9 items-center justify-center rounded-xl
                            @(Model.IsActive
                                ? "bg-emerald-50 text-emerald-600 dark:bg-emerald-500/10 dark:text-emerald-400"
                                : "bg-red-50 text-red-600 dark:bg-red-500/10 dark:text-red-400")">
                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"
                              d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
            </div>
            <p class="mt-3 text-xl font-bold @(Model.IsActive
                                                ? "text-emerald-600 dark:text-emerald-400"
                                                : "text-red-600 dark:text-red-400")">
                @(Model.IsActive ? "Active" : "Inactive")
            </p>
        </div>
    </div>

    <!-- Details Sections -->
    <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">

        <!-- General Information -->
        <div class="dashboard-card overflow-hidden lg:col-span-2">

            <div class="border-b border-slate-200 px-6 py-5 dark:border-slate-800">
                <h2 class="font-semibold text-slate-900 dark:text-white">General Information</h2>
                <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">Basic information about this warehouse.</p>
            </div>

            <dl class="divide-y divide-slate-100 dark:divide-slate-800">

                <div class="grid grid-cols-1 gap-1 px-6 py-4 sm:grid-cols-3 sm:gap-4">
                    <dt class="text-sm font-medium text-slate-500 dark:text-slate-400">Warehouse Name</dt>
                    <dd class="text-sm font-semibold text-slate-900 dark:text-white sm:col-span-2">@Model.Name</dd>
                </div>

                <div class="grid grid-cols-1 gap-1 px-6 py-4 sm:grid-cols-3 sm:gap-4">
                    <dt class="text-sm font-medium text-slate-500 dark:text-slate-400">Warehouse Code</dt>
                    <dd class="flex items-center gap-2 sm:col-span-2">
                        <span class="font-mono text-sm font-semibold text-slate-900 dark:text-white" id="codeValue">@Model.Code</span>
                        <button type="button" data-copy="#codeValue"
                                class="copy-btn rounded-md p-1 text-slate-400 transition hover:bg-slate-100 hover:text-slate-600
                                       dark:hover:bg-slate-800 dark:hover:text-slate-300"
                                title="Copy code">
                            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"
                                      d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                            </svg>
                        </button>
                    </dd>
                </div>

                <div class="grid grid-cols-1 gap-1 px-6 py-4 sm:grid-cols-3 sm:gap-4">
                    <dt class="text-sm font-medium text-slate-500 dark:text-slate-400">Branch</dt>
                    <dd class="text-sm font-semibold text-slate-900 dark:text-white sm:col-span-2">@Model.BranchName</dd>
                </div>

                <div class="grid grid-cols-1 gap-1 px-6 py-4 sm:grid-cols-3 sm:gap-4">
                    <dt class="text-sm font-medium text-slate-500 dark:text-slate-400">Status</dt>
                    <dd class="sm:col-span-2">
                        <span class="text-sm font-semibold @(Model.IsActive
                                                            ? "text-emerald-600 dark:text-emerald-400"
                                                            : "text-red-600 dark:text-red-400")">
                            @(Model.IsActive ? "Active" : "Inactive")
                        </span>
                    </dd>
                </div>

                <div class="grid grid-cols-1 gap-1 px-6 py-4 sm:grid-cols-3 sm:gap-4">
                    <dt class="text-sm font-medium text-slate-500 dark:text-slate-400">Address</dt>
                    <dd class="text-sm leading-6 text-slate-700 dark:text-slate-300 sm:col-span-2">
                        @if (string.IsNullOrWhiteSpace(Model.Address))
                        {
                            <span class="italic text-slate-400">No address has been provided.</span>
                        }
                        else
                        {
                            @Model.Address
                        }
                    </dd>
                </div>

            </dl>
        </div>

        <!-- Metadata -->
        <div class="dashboard-card overflow-hidden">

            <div class="border-b border-slate-200 px-5 py-5 dark:border-slate-800">
                <h2 class="font-semibold text-slate-900 dark:text-white">Record Information</h2>
                <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">System metadata</p>
            </div>

            <div class="space-y-5 p-5">

                <div class="flex items-start gap-3">
                    <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-slate-100 text-slate-500
                                dark:bg-slate-800 dark:text-slate-400">
                        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"
                                  d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                        </svg>
                    </div>
                    <div>
                        <p class="text-xs font-medium uppercase tracking-wider text-slate-400">Created At</p>
                        <p class="mt-1 text-sm font-semibold text-slate-900 dark:text-white">
                            @Model.CreatedAtUtc.ToLocalTime().ToString("dd MMM yyyy")
                        </p>
                        <p class="mt-0.5 text-xs text-slate-500 dark:text-slate-400">
                            @Model.CreatedAtUtc.ToLocalTime().ToString("hh:mm tt")
                        </p>
                    </div>
                </div>

                <div class="border-t border-slate-100 pt-5 dark:border-slate-800">
                    <div class="flex items-center justify-between">
                        <p class="text-xs font-medium uppercase tracking-wider text-slate-400">Warehouse ID</p>
                        <button type="button" data-copy="#idValue"
                                class="copy-btn rounded-md p-1 text-slate-400 transition hover:bg-slate-100 hover:text-slate-600
                                       dark:hover:bg-slate-800 dark:hover:text-slate-300"
                                title="Copy ID">
                            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"
                                      d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                            </svg>
                        </button>
                    </div>
                    <p id="idValue" class="mt-2 break-all font-mono text-xs leading-5 text-slate-600 dark:text-slate-400">
                        @Model.Id
                    </p>
                </div>

            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            document.querySelectorAll(".copy-btn").forEach(btn => {
                btn.addEventListener("click", async function () {
                    const target = document.querySelector(btn.dataset.copy);
                    if (!target || !navigator.clipboard) return;

                    try {
                        await navigator.clipboard.writeText(target.textContent.trim());
                        const original = btn.innerHTML;
                        btn.innerHTML =
                            '<svg class="h-4 w-4 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">' +
                            '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m5 12 4 4L19 6" /></svg>';
                        setTimeout(() => (btn.innerHTML = original), 1500);
                    } catch { /* clipboard unavailable */ }
                });
            });
        });
    </script>
}