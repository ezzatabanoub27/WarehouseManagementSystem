@model List<WarehouseManagementSystem.Application.DTOs.Branches.BranchDto>

@{
    ViewData["Title"] = "Branches";

    var totalBranches = Model.Count;
    var activeBranches = Model.Count(x => x.IsActive);
    var inactiveBranches = totalBranches - activeBranches;
    var companyCount = Model.Select(x => x.CompanyName).Distinct().Count();
}

<div class="space-y-8">

    <!-- Page Header -->
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div class="flex items-center gap-4">
            <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl
                        bg-gradient-to-br from-blue-500 to-blue-700 text-white shadow-lg shadow-blue-500/25">
                <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"
                          d="M17.657 16.657L13.414 20.9a2 2 0 01-2.828 0l-4.243-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"
                          d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
            </div>
            <div>
                <p class="text-sm font-medium text-blue-600 dark:text-blue-400">Organization Management</p>
                <h1 class="mt-0.5 text-2xl font-bold tracking-tight text-slate-900 dark:text-white">Branches</h1>
                <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
                    @totalBranches @(totalBranches == 1 ? "branch" : "branches") registered
                </p>
            </div>
        </div>

        <a asp-action="Create" class="dashboard-button-primary">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
            </svg>
            Add Branch
        </a>
    </div>

    <!-- Statistics -->
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">

        <div class="dashboard-card p-5">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium text-slate-500 dark:text-slate-400">Total Branches</p>
                    <h3 class="mt-2 text-3xl font-bold text-slate-900 dark:text-white">@totalBranches</h3>
                </div>
                <div class="rounded-xl bg-blue-50 p-3 dark:bg-blue-500/10">
                    <svg class="h-6 w-6 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"
                              d="M17.657 16.657L13.414 20.9a2 2 0 01-2.828 0l-4.243-4.243a8 8 0 1111.314 0z" />
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                </div>
            </div>
            <p class="mt-3 text-xs text-slate-400">All registered branches</p>
        </div>

        <div class="dashboard-card p-5">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium text-slate-500 dark:text-slate-400">Active</p>
                    <h3 class="mt-2 text-3xl font-bold text-slate-900 dark:text-white">@activeBranches</h3>
                </div>
                <div class="rounded-xl bg-emerald-50 p-3 dark:bg-emerald-500/10">
                    <svg class="h-6 w-6 text-emerald-600 dark:text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                </div>
            </div>
            <p class="mt-3 text-xs text-slate-400">Currently active</p>
        </div>

        <div class="dashboard-card p-5">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium text-slate-500 dark:text-slate-400">Inactive</p>
                    <h3 class="mt-2 text-3xl font-bold text-slate-900 dark:text-white">@inactiveBranches</h3>
                </div>
                <div class="rounded-xl bg-amber-50 p-3 dark:bg-amber-500/10">
                    <svg class="h-6 w-6 text-amber-600 dark:text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M12 9v4m0 4h.01M10.3 3.86L2.82 17a2 2 0 001.74 3h14.88a2 2 0 001.74-3L13.7 3.86a2 2 0 00-3.4 0z" />
                    </svg>
                </div>
            </div>
            <p class="mt-3 text-xs text-slate-400">Currently inactive</p>
        </div>

        <div class="dashboard-card p-5">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium text-slate-500 dark:text-slate-400">Companies Covered</p>
                    <h3 class="mt-2 text-3xl font-bold text-slate-900 dark:text-white">@companyCount</h3>
                </div>
                <div class="rounded-xl bg-violet-50 p-3 dark:bg-violet-500/10">
                    <svg class="h-6 w-6 text-violet-600 dark:text-violet-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"
                              d="M3 21h18M5 21V5a2 2 0 012-2h6a2 2 0 012 2v16M15 9h4a2 2 0 012 2v10M9 7h2M9 11h2M9 15h2" />
                    </svg>
                </div>
            </div>
            <p class="mt-3 text-xs text-slate-400">Companies with branches</p>
        </div>

    </div>

    <!-- Alerts -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="flex items-start gap-3 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-700 dark:border-emerald-900 dark:bg-emerald-950/40 dark:text-emerald-300">
            <svg class="mt-0.5 h-4 w-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span>@TempData["SuccessMessage"]</span>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="flex items-start gap-3 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700 dark:border-red-900 dark:bg-red-950/40 dark:text-red-300">
            <svg class="mt-0.5 h-4 w-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span>@TempData["ErrorMessage"]</span>
        </div>
    }

    <!-- Branches Table -->
    <div class="dashboard-card overflow-hidden">

        <div class="flex flex-col gap-4 border-b border-slate-200 p-5 dark:border-slate-800 lg:flex-row lg:items-center lg:justify-between">
            <div>
                <h2 class="text-base font-semibold text-slate-900 dark:text-white">All Branches</h2>
                <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">View and manage your branch records.</p>
            </div>

            <div class="flex flex-col gap-3 sm:flex-row">
                <div class="relative">
                    <svg class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400"
                         fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <circle cx="11" cy="11" r="7" stroke-width="2" />
                        <path stroke-linecap="round" stroke-width="2" d="m16 16 4 4" />
                    </svg>
                    <input id="branchSearch" type="search"
                           placeholder="Search name, code or company..."
                           class="dashboard-input pl-10 sm:w-72" />
                </div>

                <select id="statusFilter" class="dashboard-input sm:w-40">
                    <option value="all">All Status</option>
                    <option value="active">Active</option>
                    <option value="inactive">Inactive</option>
                </select>

                <button type="button" id="resetFilters"
                        class="hidden items-center justify-center gap-1.5 rounded-xl border border-slate-200 bg-white px-4 py-2.5
                               text-sm font-semibold text-slate-600 transition hover:bg-slate-50
                               dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300 dark:hover:bg-slate-800">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                    Clear
                </button>
            </div>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm">
                <thead class="bg-slate-50 text-xs uppercase tracking-wider text-slate-500 dark:bg-slate-950/60 dark:text-slate-400">
                    <tr>
                        <th class="px-6 py-4 font-semibold">Branch</th>
                        <th class="px-6 py-4 font-semibold">Company</th>
                        <th class="px-6 py-4 font-semibold">Code</th>
                        <th class="px-6 py-4 font-semibold">Address</th>
                        <th class="px-6 py-4 font-semibold">Status</th>
                        <th class="px-6 py-4 text-right font-semibold">Actions</th>
                    </tr>
                </thead>

                <tbody class="divide-y divide-slate-100 dark:divide-slate-800">

                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="px-6 py-16 text-center">
                                <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-slate-100 dark:bg-slate-800">
                                    <svg class="h-7 w-7 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7"
                                              d="M17.657 16.657L13.414 20.9a2 2 0 01-2.828 0l-4.243-4.243a8 8 0 1111.314 0z" />
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                                    </svg>
                                </div>
                                <h3 class="mt-4 font-semibold text-slate-900 dark:text-white">No branches found</h3>
                                <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
                                    Get started by adding your first branch.
                                </p>
                                <a asp-action="Create" class="dashboard-button-primary mt-5 inline-flex">Add Branch</a>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var branch in Model)
                        {
                            <tr class="branch-row transition hover:bg-slate-50 dark:hover:bg-slate-800/40"
                                data-name="@branch.Name"
                                data-code="@branch.Code"
                                data-company="@branch.CompanyName"
                                data-status="@(branch.IsActive ? "active" : "inactive")">

                                <td class="whitespace-nowrap px-6 py-4">
                                    <a asp-action="Details" asp-route-id="@branch.Id" class="group flex items-center gap-3">
                                        <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-blue-50 text-sm font-bold text-blue-600 dark:bg-blue-500/10 dark:text-blue-400">
                                            @(string.IsNullOrEmpty(branch.Name) ? "?" : branch.Name[0].ToString().ToUpper())
                                        </div>
                                        <div>
                                            <p class="font-semibold text-slate-900 transition group-hover:text-blue-600 dark:text-white dark:group-hover:text-blue-400">
                                                @branch.Name
                                            </p>
                                            <p class="mt-0.5 text-xs text-slate-400">
                                                Created @branch.CreatedAtUtc.ToLocalTime().ToString("dd MMM yyyy")
                                            </p>
                                        </div>
                                    </a>
                                </td>

                                <td class="whitespace-nowrap px-6 py-4">
                                    <span class="inline-flex items-center gap-2 text-slate-600 dark:text-slate-300">
                                        <svg class="h-4 w-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"
                                                  d="M3 21h18M5 21V5a2 2 0 012-2h6a2 2 0 012 2v16M15 9h4a2 2 0 012 2v10" />
                                        </svg>
                                        @branch.CompanyName
                                    </span>
                                </td>

                                <td class="whitespace-nowrap px-6 py-4">
                                    <span class="rounded-lg bg-slate-100 px-2.5 py-1 font-mono text-xs font-medium text-slate-600 dark:bg-slate-800 dark:text-slate-300">
                                        @branch.Code
                                    </span>
                                </td>

                                <td class="max-w-xs truncate px-6 py-4 text-slate-500 dark:text-slate-400"
                                    title="@branch.Address">
                                    @(string.IsNullOrWhiteSpace(branch.Address) ? "—" : branch.Address)
                                </td>

                                <td class="whitespace-nowrap px-6 py-4">
                                    @if (branch.IsActive)
                                    {
                                        <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-50 px-3 py-1 text-xs font-semibold text-emerald-700 dark:bg-emerald-500/10 dark:text-emerald-400">
                                            <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1.5 rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-600 dark:bg-slate-800 dark:text-slate-400">
                                            <span class="h-1.5 w-1.5 rounded-full bg-slate-400"></span>
                                            Inactive
                                        </span>
                                    }
                                </td>

                                <td class="whitespace-nowrap px-6 py-4">
                                    <div class="flex items-center justify-end gap-1">
                                        <a asp-action="Details" asp-route-id="@branch.Id"
                                           class="rounded-lg p-2 text-slate-500 transition hover:bg-blue-50 hover:text-blue-600 dark:hover:bg-blue-500/10 dark:hover:text-blue-400"
                                           title="Details">
                                            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.5 12s3.5-7 9.5-7 9.5 7 9.5 7-3.5 7-9.5 7-9.5-7-9.5-7z" />
                                            </svg>
                                        </a>

                                        <a asp-action="Edit" asp-route-id="@branch.Id"
                                           class="rounded-lg p-2 text-slate-500 transition hover:bg-amber-50 hover:text-amber-600 dark:hover:bg-amber-500/10 dark:hover:text-amber-400"
                                           title="Edit">
                                            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5" />
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.5 2.5a2.1 2.1 0 013 3L12 15l-4 1 1-4 9.5-9.5z" />
                                            </svg>
                                        </a>

                                        <form asp-action="Delete" asp-route-id="@branch.Id" method="post" class="inline">

                                            @Html.AntiForgeryToken()

                                            <button type="button"
                                                    data-name="@branch.Name"
                                                    onclick="confirmDelete(this, this.dataset.name)"
                                                    class="rounded-lg p-2 text-slate-500 transition hover:bg-red-50 hover:text-red-600 dark:hover:bg-red-500/10 dark:hover:text-red-400"
                                                    title="Delete">
                                                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                          d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                                </svg>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }

                </tbody>
            </table>
        </div>

        <div id="noSearchResults" class="hidden px-6 py-12 text-center">
            <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-2xl bg-slate-100 dark:bg-slate-800">
                <svg class="h-6 w-6 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <circle cx="11" cy="11" r="7" stroke-width="2" />
                    <path stroke-linecap="round" stroke-width="2" d="m16 16 4 4" />
                </svg>
            </div>
            <p class="mt-3 text-sm font-medium text-slate-700 dark:text-slate-200">No branches match your search</p>
            <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">Try a different keyword or clear the filters.</p>
        </div>

        <div class="border-t border-slate-200 px-6 py-4 dark:border-slate-800">
            <p class="text-xs text-slate-500 dark:text-slate-400">
                Showing <span id="visibleCount" class="font-semibold text-slate-700 dark:text-slate-200">@totalBranches</span>
                of @totalBranches @(totalBranches == 1 ? "branch" : "branches")
            </p>
        </div>

    </div>
</div>

<!-- Delete Confirmation Dialog -->
<dialog id="deleteDialog"
        class="w-full max-w-md rounded-2xl border border-slate-200 bg-white p-0 shadow-2xl
               backdrop:bg-slate-900/50 dark:border-slate-700 dark:bg-slate-900">
    <div class="p-6">
        <div class="flex items-start gap-4">
            <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-red-50 text-red-600
                        dark:bg-red-500/10 dark:text-red-400">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M12 9v4m0 4h.01M10.3 3.86L2.82 17a2 2 0 001.74 3h14.88a2 2 0 001.74-3L13.7 3.86a2 2 0 00-3.4 0z" />
                </svg>
            </div>
            <div>
                <h3 class="text-base font-semibold text-slate-900 dark:text-white">Delete branch?</h3>
                <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">
                    You are about to delete
                    <span id="deleteDialogName" class="font-semibold text-slate-800 dark:text-slate-200"></span>.
                    This action cannot be undone.
                </p>
            </div>
        </div>
    </div>

    <div class="flex flex-col-reverse gap-3 rounded-b-2xl border-t border-slate-200 bg-slate-50/70 px-6 py-4
                sm:flex-row sm:justify-end dark:border-slate-800 dark:bg-slate-950/40">
        <button type="button" id="deleteDialogCancel"
                class="inline-flex items-center justify-center rounded-xl border border-slate-200 bg-white px-5 py-2.5
                       text-sm font-semibold text-slate-700 transition hover:bg-slate-50
                       dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800">
            Cancel
        </button>
        <button type="button" id="deleteDialogConfirm"
                class="inline-flex items-center justify-center rounded-xl bg-red-600 px-5 py-2.5 text-sm
                       font-semibold text-white transition hover:bg-red-700">
            Delete
        </button>
    </div>
</dialog>

@section Scripts {
    <script>
        function confirmDelete(btn, name) {
            const dialog = document.getElementById("deleteDialog");
            const form = btn.closest("form");

            document.getElementById("deleteDialogName").textContent = name;

            document.getElementById("deleteDialogConfirm").onclick = function () {
                dialog.close();
                form.submit();
            };
            document.getElementById("deleteDialogCancel").onclick = function () {
                dialog.close();
            };

            dialog.showModal();
        }

        document.addEventListener("DOMContentLoaded", function () {
            const searchInput = document.getElementById("branchSearch");
            const statusFilter = document.getElementById("statusFilter");
            const resetBtn = document.getElementById("resetFilters");
            const rows = Array.from(document.querySelectorAll(".branch-row"));
            const visibleCount = document.getElementById("visibleCount");
            const noResults = document.getElementById("noSearchResults");

            function filterBranches() {
                const searchTerm = searchInput.value.trim().toLowerCase();
                const selectedStatus = statusFilter.value;
                let count = 0;

                rows.forEach(row => {
                    const searchableText = [
                        row.dataset.name,
                        row.dataset.code,
                        row.dataset.company
                    ].join(" ").toLowerCase();

                    const matchesSearch = searchableText.includes(searchTerm);
                    const matchesStatus =
                        selectedStatus === "all" ||
                        row.dataset.status === selectedStatus;

                    const visible = matchesSearch && matchesStatus;
                    row.classList.toggle("hidden", !visible);
                    if (visible) count++;
                });

                visibleCount.textContent = count;
                noResults.classList.toggle("hidden", count !== 0 || rows.length === 0);

                const filtering = searchTerm !== "" || selectedStatus !== "all";
                resetBtn.classList.toggle("hidden", !filtering);
                resetBtn.classList.toggle("inline-flex", filtering);
            }

            resetBtn.addEventListener("click", function () {
                searchInput.value = "";
                statusFilter.value = "all";
                filterBranches();
                searchInput.focus();
            });

            searchInput.addEventListener("input", filterBranches);
            statusFilter.addEventListener("change", filterBranches);
        });
    </script>
}